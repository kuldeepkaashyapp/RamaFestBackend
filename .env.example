# Activate the production profile with: SPRING_PROFILES_ACTIVE=prod
SPRING_PROFILES_ACTIVE=prod
IMAGE_NAME=ghcr.io/kuldeepkaashyapp/ramafest
IMAGE_TAG=latest

# PostgreSQL
DB_URL=jdbc:postgresql://db-host:5432/ramafest_db
DB_USERNAME=ramafest_app
DB_PASSWORD=replace-with-a-secret

# Public application URLs
FRONTEND_URL=https://www.example.com
ALLOWED_ORIGINS=https://www.example.com
API_URL=https://api.example.com

# Server and operational settings
PORT=8000
JPA_DDL_AUTO=validate
UPLOAD_DIR=uploads
SHUTDOWN_TIMEOUT=30s
APP_AUDIT_TRUSTED_PROXIES=
SESSION_TIMEOUT=30m
COOKIE_SAME_SITE=none
COOKIE_SECURE=true
SPRINGDOC_ENABLED=false

# Docker database service
POSTGRES_DB=ramafest_db
POSTGRES_USER=ramafest_app
POSTGRES_PASSWORD=replace-with-a-secret

# Private GHCR pull credentials (server only; do not commit real values)
GHCR_PULL_USERNAME=your-github-username
GHCR_PULL_TOKEN=replace-with-a-read-packages-token
